{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // tsc emits JavaScript for a file that failed to typecheck unless told not
    // to. On a deploy box that means a failed build still leaves runnable
    // rubbish in dist/, waiting for the next restart to pick it up.
    "noEmitOnError": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
