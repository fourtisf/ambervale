# --- root: docker-compose only ----------------------------------------------
# Copy to .env. These values are read by `docker compose` and must stay in sync
# with DATABASE_URL / REDIS_URL in apps/api/.env.

POSTGRES_USER=ambervale
POSTGRES_PASSWORD=ambervale
POSTGRES_DB=ambervale
POSTGRES_PORT=5432

REDIS_PORT=6379

# Per-app configuration lives in:
#   apps/api/.env        (see apps/api/.env.example)
#   apps/web/.env.local  (see apps/web/.env.example)
