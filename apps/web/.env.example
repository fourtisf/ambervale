# --- apps/web ---------------------------------------------------------------
# Copy to apps/web/.env.local and adjust.

# Port Next.js listens on (PM2 runs this on 4022).
PORT=4022

# Base URL of the Fastify API. Must match apps/api WEB_ORIGIN's counterpart.
# NEXT_PUBLIC_ is required: the Phaser client calls this from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4021
API_URL=http://localhost:4021
