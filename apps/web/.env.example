# --- apps/web ---------------------------------------------------------------
# Copy to apps/web/.env.local and adjust.

# Port Next.js listens on (PM2 runs this on 4022).
PORT=4022

# Base URL of the Fastify API. NEXT_PUBLIC_ is required: the browser calls it.
#
# IMPORTANT: browse the game on the SAME HOST that appears here. The session
# cookie is SameSite=Lax, and "localhost" and "127.0.0.1" are different sites,
# so opening http://127.0.0.1:4022 against an API on http://localhost:4021
# silently drops the cookie on every request after login.
NEXT_PUBLIC_API_URL=http://localhost:4021

# Absolute base for share cards and canonical links. Read at BUILD time by
# app/layout.tsx; leave it unset to fall back to https://ambervale.fun.
NEXT_PUBLIC_SITE_URL=

# Written by ops/deploy.sh — the commit the bundle was built from, emitted as
# <meta name="ambervale-rev">. Never set this by hand.
NEXT_PUBLIC_BUILD_REV=
API_URL=http://localhost:4021

# --- chain (Phase 7) ---------------------------------------------------------
# Robinhood Chain is an Arbitrum Orbit rollup, so a stock EVM chain definition
# is all that is needed. Ids and RPCs live here so they can be corrected when
# the real values are published, without a code change. See docs/DECISIONS.md.
NEXT_PUBLIC_CHAIN_ENV=testnet
NEXT_PUBLIC_CHAIN_ID_TESTNET=421614
NEXT_PUBLIC_CHAIN_ID_MAINNET=42161
NEXT_PUBLIC_RPC_TESTNET=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_RPC_MAINNET=https://arb1.arbitrum.io/rpc

# Optional: enables the WalletConnect connector for mobile wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public X profile. Defaults to the real account in code, so the link works
# without any deploy-time configuration; set this only to point somewhere else.
NEXT_PUBLIC_X_URL=

# The $AMBER contract address, once one exists.
#
# Left empty the site says "coming soon" and shows nothing to copy, which is
# the truth today: there is no contract. Fill this in and the same row becomes
# the address with a working copy button — no code change, and no window in
# which the page is claiming an address that is not real.
NEXT_PUBLIC_AMBER_CA=

# Error reporting. Leave empty to disable Sentry entirely (the default).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
