// AMBERVALE — Prisma schema.
//
// The server is authoritative: every number that matters to a player's balance
// lives in a row here, and the client is only ever told about it. Gameplay
// constants (grow times, prices, XP) are NOT stored — they come from
// packages/game-config at read time, so retuning the game never needs a
// migration or a backfill.
//
// All timestamps are DateTime (UTC); the API serialises them to epoch ms.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  /// Null until an account is upgraded from guest to email. Kept nullable so
  /// magic-link auth can be added later without a schema change.
  email    String? @unique
  /// Stable per-browser id. Lets a player who cleared cookies get their farm
  /// back, and is what /auth/guest looks up before creating an account.
  deviceId String  @unique

  level Int @default(1)
  xp    Int @default(0)
  coins Int @default(0)
  rep   Int @default(0)

  tutorialStep Int @default(0)
  /// Counters as they stood when the tutorial last started, so a replay asks
  /// for three crops planted *now* rather than reading a veteran's lifetime
  /// total and skipping to the end. Null means "from zero", which is what
  /// every account that never replayed it wants.
  tutorialBase Json?
  questIndex   Int @default(0)

  /// The very first crop a player plants grows in FIRST_CROP_FAST_SEC.
  firstPlantDone Boolean @default(false)
  /// Guards bootstrap so a concurrent first request cannot double-seed a farm.
  bootstrapped   Boolean @default(false)

  // Quest counters. Monotonic, so the quest chain can be re-evaluated from
  // scratch after any action without storing per-quest progress.
  plantedCount   Int @default(0)
  harvestedCount Int @default(0)
  choppedCount   Int @default(0)
  minedCount     Int @default(0)
  soldCount      Int @default(0)
  boughtSeeds    Int @default(0)
  milkCount      Int @default(0)
  eggCount       Int @default(0)
  deliveriesDone Int @default(0)
  fishCount      Int @default(0)
  craftCount     Int @default(0)
  upgradesBought Int @default(0)
  /// The two field verbs added after crows arrived. They had no counters, so
  /// nothing could ask a player to use them — a daily list that never mentions
  /// watering is a daily list that teaches watering does not matter.
  wateredCount   Int @default(0)
  shooedCount    Int @default(0)

  /// Prestige bought from the Vale Fund. Purely a rank — it grants no power,
  /// so an endless coin and $AMBER sink cannot turn into pay-to-win.
  renown Int @default(0)

  /// Last time this player looked at their farm. The gap since is what the
  /// "while you were away" report is measured over.
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plots         Plot[]
  nodes         ResourceNode[]
  animals       Animal[]
  groundItems   GroundItem[]
  inventory     InventoryItem[]
  seeds         SeedItem[]
  deliverySlots DeliverySlot[]
  amberLedger   AmberLedger[]
  expansion     Expansion?
  wallet        Wallet?
  claimIntents  ClaimIntent[]
  upgrades      Upgrade[]
  daily         DailyState?
  market        MarketGood[]
  builds        Build[]

  @@index([createdAt])
  @@index([renown])
  @@index([xp])
}

/// One tilled square. `index` maps to a fixed world coordinate via PLOTS in
/// game-config, so position never needs storing.
model Plot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  index Int
  /// "base" | "north" — north plots are unusable until Expansion.north.
  zone  String

  cropKey   String?
  plantedAt DateTime?
  /// True when this plot is growing the player's accelerated first crop.
  fast      Boolean   @default(false)

  /// When this crop was watered, or null. One watering per planting: cleared
  /// on plant and on harvest, so it cannot be carried over or re-spent.
  wateredAt  DateTime?
  /// Milliseconds already taken off this crop's grow time by watering.
  ///
  /// Stored rather than recomputed from wateredAt because the cut depends on
  /// how much time was left at the moment of watering — a number that stops
  /// existing the instant the clock moves on.
  waterCutMs Int       @default(0)

  /// Crows stay away from this plot until this moment. Set by shooing one off,
  /// and readable before the crop is even ready, so walking the field early is
  /// worth doing.
  guardedUntil DateTime?

  @@unique([userId, index])
  @@index([userId])
}

/// Something the player has built, that stays built.
///
/// Position is not stored: the key maps to a fixed tile in game-config's
/// BUILDS, exactly as plots and nodes do. One row per landmark per player,
/// and the unique index is what makes "build it twice" impossible under any
/// amount of double-clicking.
model Build {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// BuildKey from game-config.
  key     String
  builtAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

/// How saturated one player's market is with one good.
///
/// Prices sag as a player floods the market and recover on their own, so the
/// crop menu stops being a list sorted for you. Decay is computed lazily from
/// `updatedAt` on every read — like respawns and egg laying, this needs no
/// scheduler and a farm nobody opened for a week comes back correct.
model MarketGood {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ItemKey from game-config.
  itemKey    String
  /// Saturation at `updatedAt`. Decays from there; never stored decayed.
  saturation Float  @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, itemKey])
  @@index([userId])
}

/// A choppable oak or mineable rock. Position comes from NODE_SLOTS.
model ResourceNode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  index Int
  /// "oak" | "rock"
  kind  String
  hp    Int

  /// Set when depleted; a lazy pass on read restores hp once it has passed.
  respawnAt DateTime?

  @@unique([userId, index])
  @@index([userId])
}

model Animal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  index Int
  /// "chicken" | "cow"
  kind  String

  /// When this animal's next egg/milk becomes available.
  nextYieldAt DateTime
  /// Cows hold their milk until collected; chickens drop GroundItems instead.
  ready       Boolean  @default(false)

  @@unique([userId, index])
  @@index([userId])
}

/// An uncollected egg lying in the coop yard. Capped per ANIMALS.chicken.
model GroundItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemKey String
  /// World position in pixels, chosen server-side when the egg is laid.
  x       Float
  y       Float

  createdAt DateTime @default(now())

  @@index([userId])
}

model InventoryItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemKey String
  qty     Int    @default(0)

  @@unique([userId, itemKey])
  @@index([userId])
}

model SeedItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cropKey String
  qty     Int    @default(0)

  @@unique([userId, cropKey])
  @@index([userId])
}

/// One of the three delivery board orders.
model DeliverySlot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slot  Int
  /// "open" | "done"
  state String @default("open")

  itemKey String?
  qty     Int?
  amber   Int?
  /// NPC index, so the same face stays on the same order across reloads.
  npc     Int     @default(0)
  /// Seed the order was generated from — generation is server-only and
  /// reproducible for audit.
  seed    Int     @default(0)

  /// When a completed slot regenerates.
  refillAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, slot])
  @@index([userId])
}

/// Append-only $AMBER ledger. Balance is SUM(delta) — never a stored column,
/// so it cannot drift from its own history.
model AmberLedger {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  delta  Int
  /// "delivery" | "quest" | "claim_lock" | ...
  reason String
  /// Points at whatever caused the entry (delivery slot id, quest id).
  refId  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A purchased upgrade tier. Absent row means tier 0, so buying the first tier
/// and buying the fourth go through exactly the same code path.
model Upgrade {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// UpgradeKey from game-config. Not an enum: retuning the upgrade table is a
  /// config edit everywhere else in this codebase, and it stays one here.
  key  String
  tier Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

/// The player's position in the daily-goal cycle.
///
/// Progress is "counter now minus counter at the start of the day", so the
/// baseline snapshot below is the only per-day state that needs storing — the
/// goals themselves are derived from the date and never persisted.
model DailyState {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Days since the Unix epoch, UTC. Rolling this over is the daily reset.
  day      Int
  /// Counter values as they stood when `day` began.
  baseline Json
  /// Bitmask over the day's picks, so a goal pays out exactly once.
  claimed  Int  @default(0)

  streak          Int @default(0)
  /// Last day whose goals were all finished, so a streak cannot double-count.
  lastCompleteDay Int @default(-1)

  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Expansion {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  north Boolean @default(false)
  east  Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// One wallet per account and one account per wallet (Phase 7).
model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  address String @unique
  chainId Int

  linkedAt DateTime @default(now())
}

/// A request to move $AMBER on-chain. Inert until ENABLE_CLAIM (Phase 7).
model ClaimIntent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount Int
  /// "pending" | "sent" | "failed"
  status String  @default("pending")
  txHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// Idempotency records for mutating actions that must never double-apply.
model IdempotencyKey {
  id     String @id @default(cuid())
  userId String
  key    String
  /// Endpoint the key was used against, so the same key on a different action
  /// cannot replay a stale result.
  scope  String
  /// JSON response body to replay verbatim on a repeat call.
  result Json

  createdAt DateTime @default(now())

  @@unique([userId, scope, key])
  @@index([createdAt])
}

/// Append-only audit trail. Every mutating action writes one row.
model EventLog {
  id        String   @id @default(cuid())
  userId    String?
  kind      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}
