# --- apps/api ---------------------------------------------------------------
# Copy to apps/api/.env and adjust. Values below match docker-compose.yml.

NODE_ENV=development
LOG_LEVEL=debug

# Bind address for the Fastify server (PM2 runs this on 4021).
HOST=0.0.0.0
PORT=4021

# PostgreSQL — must match the credentials in the root .env used by docker compose.
DATABASE_URL=postgresql://ambervale:ambervale@localhost:5432/ambervale?schema=public

# Redis — sessions, rate limits and action locks.
REDIS_URL=redis://localhost:6379

# Browser origins allowed to call this API (CORS + cookies), comma-separated.
# localhost and 127.0.0.1 are distinct origins, so list both in dev.
WEB_ORIGIN=http://localhost:4022,http://127.0.0.1:4022

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production-0000000000000000000000000000000000000000

# $AMBER claim flow stays hard-off until the contract exists (Phase 7).
# With this false, /claim/intent refuses outright and /claim/quota reports
# claimable=0 whatever the ledger says.
ENABLE_CLAIM=false

# Closed beta. A player must present this before the API will create or
# resume an account. Set it to an empty value to open the game to everyone —
# the default is deliberately closed, so a deploy that forgets it stays shut.
INVITE_CODE=1990

# Which upstream hops may be believed about a caller's IP address. Keep this
# as narrow as the deployment allows: it is what stops someone handing
# themselves a fresh identity per request with an X-Forwarded-For header and
# guessing the invite code without limit. 'loopback' is right when nginx runs
# on the same host as the API.
TRUST_PROXY=loopback

# Basic auth for GET /admin/claim-intents (CSV export for manual payouts).
# An empty password disables the endpoint entirely.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Error reporting. Leave empty to disable Sentry entirely (the default).
SENTRY_DSN=
